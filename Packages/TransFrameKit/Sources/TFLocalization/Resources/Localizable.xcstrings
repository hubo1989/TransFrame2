    "color.clearConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear all picked colors? Other history is kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
