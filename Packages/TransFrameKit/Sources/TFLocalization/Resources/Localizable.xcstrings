    "action.crop.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to choose the area to keep; Return applies, Esc cancels"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖拽选择保留区域，回车应用、Esc 取消"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu behaltenden Bereich aufziehen; Zeilenschalter übernimmt, Esc bricht ab"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para elegir la zona que se conserva; Retorno aplica, Esc cancela"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour choisir la zone à conserver ; Retour applique, Échap annule"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per scegliere l'area da tenere; Invio applica, Esc annulla"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残す範囲をドラッグで選択。Return で適用、Esc で取消"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남길 영역을 드래그로 선택. Return으로 적용, Esc로 취소"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para escolher a área a manter; Return aplica, Esc cancela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите область, которую нужно оставить; Return — применить, Esc — отмена"
          }
        }
      }
