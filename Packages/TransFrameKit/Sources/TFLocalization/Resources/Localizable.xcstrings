    "hotkeyFailure.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These shortcuts could not be registered: %@. Another app may be using them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下快捷键无法注册：%@。可能被其他应用占用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kurzbefehle konnten nicht registriert werden: %@. Möglicherweise verwendet eine andere App sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron registrar estos atajos: %@. Es posible que otra app los esté usando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer ces raccourcis : %@. Une autre app les utilise peut-être."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile registrare queste abbreviazioni: %@. Potrebbero essere usate da un’altra app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のショートカットを登録できませんでした：%@。別のアプリで使用されている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 단축키를 등록할 수 없습니다: %@. 다른 앱에서 사용 중일 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível registrar estes atalhos: %@. Outro app pode estar usando-os."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось зарегистрировать сочетания клавиш: %@. Возможно, они заняты другим приложением."
          }
        }
      }
    },
