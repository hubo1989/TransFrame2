          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个模型翻译同样的三句话，记录完整响应时间，每个模型最多等待 20 秒。测速会发出真实请求，可能产生费用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Modell übersetzt dieselben drei Sätze; gemessen wird die vollständige Antwortzeit, höchstens 20 Sekunden pro Modell. Es sind echte Anfragen, die berechnet werden können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada modelo traduce las mismas tres frases; se mide el tiempo de respuesta completo, hasta 20 segundos por modelo. Son solicitudes reales y pueden facturarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque modèle traduit les trois mêmes phrases ; le temps de réponse complet est mesuré, jusqu’à 20 secondes par modèle. Ce sont de vraies requêtes, qui peuvent être facturées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni modello traduce le stesse tre frasi; viene misurato il tempo di risposta completo, fino a 20 secondi per modello. Sono richieste reali e possono essere addebitate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各モデルで同じ 3 文を翻訳し、完全な応答時間を測定します（1 モデルあたり最大 20 秒）。実際のリクエストのため、料金が発生する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 모델이 같은 세 문장을 번역하며 전체 응답 시간을 측정합니다(모델당 최대 20초). 실제 요청이므로 요금이 부과될 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada modelo traduz as mesmas três frases; o tempo de resposta completo é medido, até 20 segundos por modelo. São solicitações reais e podem ser cobradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая модель переводит одни и те же три предложения; измеряется полное время ответа, не более 20 секунд на модель. Это реальные запросы, они могут тарифицироваться."
          }
        }
      }
    },
