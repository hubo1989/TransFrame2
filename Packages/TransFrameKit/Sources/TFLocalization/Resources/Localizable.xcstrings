    "error.capture.timedOut.suggestion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again. If it keeps happening, restart TransFrame 2."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重试；如果反复出现，请重启 TransFrame 2。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es erneut. Wenn das Problem weiterhin auftritt, starten Sie TransFrame 2 neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inténtalo de nuevo. Si sigue ocurriendo, reinicia TransFrame 2."
          }
