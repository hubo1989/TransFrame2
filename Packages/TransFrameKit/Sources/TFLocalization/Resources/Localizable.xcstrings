    "settings.general.detectWindowsNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While selecting, the window under the pointer is highlighted: click to select it, double-click to capture it right away. Tab cycles overlapping windows; Space switches to a free selection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "框选时高亮指针下的窗口：单击选中，双击直接截取该窗口。Tab 在重叠窗口间切换，空格切换为自由框选。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Auswählen wird das Fenster unter dem Zeiger hervorgehoben: Klicken wählt es aus, Doppelklicken nimmt es sofort auf. Tab wechselt zwischen überlappenden Fenstern, die Leertaste schaltet auf freie Auswahl um."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al seleccionar se resalta la ventana bajo el puntero: haz clic para seleccionarla o doble clic para capturarla al instante. Tab alterna entre ventanas superpuestas; Espacio cambia a selección libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant la sélection, la fenêtre sous le pointeur est mise en évidence : cliquez pour la sélectionner, double-cliquez pour la capturer aussitôt. Tab passe d'une fenêtre superposée à l'autre ; Espace bascule en sélection libre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la selezione la finestra sotto il puntatore viene evidenziata: fai clic per selezionarla, doppio clic per catturarla subito. Tab passa tra finestre sovrapposte; Spazio passa alla selezione libera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲選択中はポインタの下のウインドウを強調表示します。クリックで選択、ダブルクリックでそのウインドウをすぐにキャプチャします。Tab で重なったウインドウを切り替え、スペースで自由選択に切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역을 선택할 때 포인터 아래의 윈도우를 강조 표시합니다. 클릭하면 선택하고 이중 클릭하면 바로 캡처합니다. Tab으로 겹친 윈도우를 전환하고 스페이스로 자유 선택으로 바꿉니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao selecionar, a janela sob o ponteiro é destacada: clique para selecioná-la ou clique duas vezes para capturá-la na hora. Tab alterna entre janelas sobrepostas; Espaço muda para seleção livre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При выделении окно под указателем подсвечивается: щелчок выбирает его, двойной щелчок сразу делает снимок. Tab переключает перекрывающиеся окна, пробел — свободное выделение."
          }
        }
      }
    },
