    "tool.text.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to type. Return finishes, Esc cancels; double-click text to edit it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单击输入文字，回车完成、Esc 取消；双击已有文字可再次编辑"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken und tippen. Zeilenschalter beendet, Esc bricht ab; Text zum Bearbeiten doppelklicken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para escribir. Retorno termina, Esc cancela; doble clic en un texto para editarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour saisir. Retour valide, Échap annule ; double-cliquez sur un texte pour le modifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic per scrivere. Invio conferma, Esc annulla; doppio clic su un testo per modificarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックして入力。Return で確定、Esc で取消。テキストをダブルクリックで再編集"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하여 입력. Return으로 완료, Esc로 취소. 텍스트를 이중 클릭하면 다시 편집"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para digitar. Return conclui, Esc cancela; clique duas vezes num texto para editá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щёлкните и вводите текст. Return — готово, Esc — отмена; двойной щелчок по тексту — правка."
          }
        }
      }
    },
