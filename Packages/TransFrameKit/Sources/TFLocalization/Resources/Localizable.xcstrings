    "error.invariant.suggestion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please try again. If it keeps happening, restart TransFrame 2."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重试；如果反复出现，请重启 TransFrame 2。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte versuchen Sie es erneut. Wenn das Problem weiterhin auftritt, starten Sie TransFrame 2 neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inténtalo de nuevo. Si sigue ocurriendo, reinicia TransFrame 2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez réessayer. Si le problème persiste, redémarrez TransFrame 2."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova. Se il problema persiste, riavvia TransFrame 2."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やり直してください。繰り返し発生する場合は、TransFrame 2 を再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시도하세요. 문제가 계속되면 TransFrame 2를 재시작하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente. Se continuar acontecendo, reinicie o TransFrame 2."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторите попытку. Если ошибка повторяется, перезапустите TransFrame 2."
          }
        }
      }
    },
