    "error.hotkey.registrationFailed.suggestion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app may be using it. Change it in Settings › Shortcuts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能被其他应用占用，请在“设置 › 快捷键”中修改。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möglicherweise wird er von einer anderen App verwendet. Ändern Sie ihn unter Einstellungen › Kurzbefehle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que otra app lo esté usando. Cámbialo en Ajustes › Atajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre app l’utilise peut-être. Modifiez-le dans Réglages › Raccourcis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe essere usato da un’altra app. Modificalo in Impostazioni › Abbreviazioni."
          }
