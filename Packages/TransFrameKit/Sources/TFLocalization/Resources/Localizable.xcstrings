    "onboarding.permissions.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TransFrame 2 needs two permissions. Click Grant Access and drag the app into the list in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TransFrame 2 需要两项权限。点击“去授权”，然后把应用拖进系统设置中的列表。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TransFrame 2 benötigt zwei Berechtigungen. Klicken Sie auf „Zugriff erlauben“ und ziehen Sie die App in die Liste in den Systemeinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TransFrame 2 necesita dos permisos. Haz clic en Conceder acceso y arrastra la app a la lista en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TransFrame 2 a besoin de deux autorisations. Cliquez sur Accorder l’accès, puis faites glisser l’app dans la liste de Réglages Système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TransFrame 2 richiede due autorizzazioni. Fai clic su Consenti accesso e trascina l’app nell’elenco in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TransFrame 2 には 2 つの権限が必要です。「アクセスを許可」をクリックし、システム設定のリストにアプリをドラッグしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TransFrame 2에는 두 가지 권한이 필요합니다. ‘접근 허용’을 클릭하고 시스템 설정의 목록으로 앱을 드래그하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O TransFrame 2 precisa de duas permissões. Clique em Permitir acesso e arraste o app para a lista em Ajustes do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TransFrame 2 требуются два разрешения. Нажмите «Предоставить доступ» и перетащите приложение в список в Системных настройках."
          }
        }
      }
    },
