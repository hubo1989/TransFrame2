    "settings.general.languageNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System panels such as file dialogs and update windows follow the system language."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件对话框、更新窗口等系统界面仍跟随系统语言。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemfenster wie Dateidialoge und Update-Fenster folgen der Systemsprache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los paneles del sistema, como los cuadros de diálogo de archivos y las ventanas de actualización, siguen el idioma del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les panneaux système, tels que les boîtes de dialogue de fichiers et les fenêtres de mise à jour, suivent la langue du système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pannelli di sistema, come le finestre di dialogo dei file e gli aggiornamenti, seguono la lingua di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルダイアログやアップデートウィンドウなどのシステムパネルはシステム言語に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 대화상자 및 업데이트 창과 같은 시스템 패널은 시스템 언어를 따릅니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Painéis do sistema, como caixas de diálogo de arquivos e janelas de atualização, seguem o idioma do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системные панели, такие как диалоги выбора файлов и окна обновлений, используют язык системы."
          }
        }
      }
    },
