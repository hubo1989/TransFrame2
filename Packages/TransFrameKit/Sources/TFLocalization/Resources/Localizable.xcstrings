    "privacy.guardNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detection runs on this Mac. It lowers the risk but cannot catch everything."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测在本机进行，可降低风险，但不能保证识别全部敏感内容。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erkennung läuft lokal auf diesem Mac. Sie senkt das Risiko, erkennt aber nicht alles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La detección se ejecuta en este Mac. Reduce el riesgo, pero no puede detectarlo todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection s’effectue sur ce Mac. Elle réduit le risque sans tout intercepter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rilevamento avviene su questo Mac. Riduce il rischio, ma non può rilevare tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検出はこの Mac 上で実行されます。リスクを低減しますが、すべてを検出できるわけではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감지는 이 Mac에서 실행됩니다. 위험을 줄여주지만 모든 항목을 감지할 수는 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A detecção ocorre neste Mac. Ela reduz o risco, mas não detecta tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка выполняется на этом Mac. Она снижает риск, но не гарантирует выявление всех данных."
