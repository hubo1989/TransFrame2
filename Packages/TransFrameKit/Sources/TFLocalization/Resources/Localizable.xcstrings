    "coexistence.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TransFrame 1.x is running and uses the same shortcuts, so some shortcuts may trigger the wrong app. Quit TransFrame 1.x or change the shortcuts of TransFrame 2."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TransFrame 1.x 正在运行并使用相同的快捷键，部分快捷键可能会触发错误的应用。请退出 TransFrame 1.x，或修改 TransFrame 2 的快捷键。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TransFrame 1.x wird ausgeführt und verwendet dieselben Kurzbefehle, sodass einige Kurzbefehle möglicherweise die falsche App auslösen. Beenden Sie TransFrame 1.x oder ändern Sie die Kurzbefehle von TransFrame 2."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TransFrame 1.x está en ejecución y usa los mismos atajos, por lo que algunos atajos podrían activar la app equivocada. Sal de TransFrame 1.x o cambia los atajos de TransFrame 2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TransFrame 1.x est en cours d’exécution et utilise les mêmes raccourcis ; certains raccourcis risquent de déclencher la mauvaise app. Quittez TransFrame 1.x ou modifiez les raccourcis de TransFrame 2."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TransFrame 1.x è in esecuzione e usa le stesse abbreviazioni, quindi alcune potrebbero attivare l’app sbagliata. Esci da TransFrame 1.x o modifica le abbreviazioni di TransFrame 2."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TransFrame 1.x が実行中で同じショートカットを使用しているため、一部のショートカットで別のアプリが起動する場合があります。TransFrame 1.x を終了するか、TransFrame 2 のショートカットを変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TransFrame 1.x가 실행 중이며 동일한 단축키를 사용하고 있어 일부 단축키가 잘못된 앱을 실행할 수 있습니다. TransFrame 1.x를 종료하거나 TransFrame 2의 단축키를 변경하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O TransFrame 1.x está em execução e usa os mesmos atalhos, portanto alguns atalhos podem acionar o app errado. Encerre o TransFrame 1.x ou altere os atalhos do TransFrame 2."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение TransFrame 1.x запущено и использует те же сочетания клавиш, поэтому некоторые из них могут срабатывать в другом приложении. Завершите TransFrame 1.x или измените сочетания клавиш TransFrame 2."
          }
        }
      }
    },
