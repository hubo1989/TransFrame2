          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置 › 隐私与安全性 › 屏幕录制”中允许 TransFrame 2，然后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie TransFrame 2 unter Systemeinstellungen › Datenschutz & Sicherheit › Bildschirmaufnahme und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
