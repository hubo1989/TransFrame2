          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」›「プライバシーとセキュリティ」›「画面収録」で TransFrame 2 を許可してから、やり直してください。"
          }
        },
        "ko": {
