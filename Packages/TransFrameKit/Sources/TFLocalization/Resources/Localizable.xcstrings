        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린샷의 텍스트를 인식하고 이미지 위에서 바로 번역을 확인하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconheça textos em capturas de tela e veja as traduções direto na imagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавайте текст на снимках экрана и смотрите перевод прямо поверх изображения."
          }
        }
      }
    },
