    "onboarding.welcome.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognize text in screenshots and see translations right on the image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别截图中的文字，并直接在图上查看译文。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennen Sie Text in Screenshots und sehen Sie Übersetzungen direkt auf dem Bild."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconoce texto en capturas de pantalla y ve las traducciones directamente sobre la imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnaissez le texte dans les captures d’écran et affichez les traductions directement sur l’image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconosci il testo negli screenshot e visualizza le traduzioni direttamente sull’immagine."
