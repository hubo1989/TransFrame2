    "error.permission.accessibilityDenied.suggestion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow TransFrame 2 in System Settings › Privacy & Security › Accessibility to read and insert text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置 › 隐私与安全性 › 辅助功能”中允许 TransFrame 2，以便读取和插入文本。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie TransFrame 2 unter Systemeinstellungen › Datenschutz & Sicherheit › Bedienungshilfen, um Text zu lesen und einzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a TransFrame 2 en Ajustes del Sistema › Privacidad y seguridad › Accesibilidad para leer e insertar texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez TransFrame 2 dans Réglages Système › Confidentialité et sécurité › Accessibilité pour lire et insérer du texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso a TransFrame 2 in Impostazioni di Sistema › Privacy e sicurezza › Accessibilità per leggere e inserire testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストの読み取りと挿入を行うには、「システム設定」›「プライバシーとセキュリティ」›「アクセシビリティ」で TransFrame 2 を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트를 읽고 삽입하려면 시스템 설정 › 개인정보 보호 및 보안 › 손쉬운 사용에서 TransFrame 2를 허용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o TransFrame 2 em Ajustes do Sistema › Privacidade e Segurança › Acessibilidade para ler e inserir texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите TransFrame 2 доступ в разделе «Системные настройки › Конфиденциальность и безопасность › Универсальный доступ» для чтения и вставки текста."
          }
        }
      }
    },
