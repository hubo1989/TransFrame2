    "settings.shortcuts.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts need ⌘, ⌃ or ⌥. Press Esc to cancel recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键需包含 ⌘、⌃ 或 ⌥。按 Esc 取消录制。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehle müssen ⌘, ⌃ oder ⌥ enthalten. Esc zum Abbrechen drücken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos deben incluir ⌘, ⌃ o ⌥. Pulsa Esc para cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis doivent inclure ⌘, ⌃ ou ⌥. Appuyez sur Esc pour annuler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le abbreviazioni devono includere ⌘, ⌃ o ⌥. Premi Esc per annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットには ⌘、⌃、または ⌥ が必要です。Esc でキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키에는 ⌘, ⌃ 또는 ⌥가 필요합니다. Esc를 눌러 기록을 취소하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos precisam de ⌘, ⌃ ou ⌥. Pressione Esc para cancelar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетание должно содержать ⌘, ⌃ или ⌥. Нажмите Esc для отмены."
          }
        }
      }
    },
