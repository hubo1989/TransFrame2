    "about.tagline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture, annotate, recognize and translate — right on your screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图、标注、识别、翻译，就在屏幕上完成。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnehmen, markieren, erkennen und übersetzen – direkt auf dem Bildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura, anota, reconoce y traduce, directamente en tu pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturez, annotez, reconnaissez et traduisez directement à l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cattura, annota, riconosci e traduci, direttamente sullo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上でそのままキャプチャ、注釈、文字認識、翻訳。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에서 바로 캡처, 주석, 인식, 번역까지."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture, anote, reconheça e traduza — direto na sua tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимайте, размечайте, распознавайте и переводите — прямо на экране."
          }
        }
      }
    },
