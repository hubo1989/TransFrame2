    "settings.general.resetConfirmMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All settings return to their defaults. Saved keys and history are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部设置将恢复默认值，已保存的密钥和历史不受影响。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Einstellungen werden auf die Standardwerte zurückgesetzt. Gespeicherte Schlüssel und der Verlauf bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los ajustes volverán a sus valores predeterminados. Se conservarán las claves guardadas y el historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les réglages retrouveront leurs valeurs par défaut. Les clés enregistrées et l’historique sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le impostazioni torneranno ai valori predefiniti. Le chiavi salvate e la cronologia verranno mantenute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての設定がデフォルト値に戻ります。保存されたキーと履歴は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 설정이 기본값으로 되돌아갑니다. 저장된 키와 기록은 유지됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os ajustes retornarão aos padrões. Chaves salvas e o histórico serão mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все настройки вернутся к значениям по умолчанию. Сохранённые ключи и история сохранятся."
          }
        }
      }
    },
