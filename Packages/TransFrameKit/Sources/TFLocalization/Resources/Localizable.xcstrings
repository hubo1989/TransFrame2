    "error.persistence.migrationFailed.suggestion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old file was moved aside and a new history was created."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧文件已被移到一旁，并已新建历史。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die alte Datei wurde beiseite gelegt und ein neuer Verlauf erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo anterior se apartó y se creó un nuevo historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ancien fichier a été mis de côté et un nouvel historique a été créé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vecchio file è stato spostato ed è stata creata una nuova cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いファイルは別の場所へ移動され、新しい履歴が作成されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 파일은 별도로 보관되었으며 새 기록이 생성되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo antigo foi movido e um novo histórico foi criado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старый файл был перемещён, и создана новая история."
          }
        }
      }
    },
